-- ตัวแปรระบบบิน
local fly = false
local spd = 50
local inf = false
local hj = false
local jp = 50
local bv, bg, flyConn
local ControlModule = nil

task.spawn(function()
    pcall(function()
        ControlModule = require(LP:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule"):WaitForChild("ControlModule"))
    end)
end)

local function stopFly()
    if flyConn then flyConn:Disconnect() flyConn = nil end
    if bv then bv:Destroy() bv = nil end
    if bg then bg:Destroy() bg = nil end
    if LP.Character then
        local h = LP.Character:FindFirstChildOfClass("Humanoid")
        if h then h.PlatformStand = false end
    end
end

local function startFly()
    stopFly()
    local char = LP.Character or LP.CharacterAdded:Wait()
    local h = char:WaitForChild("Humanoid")
    local r = char:WaitForChild("HumanoidRootPart")

    h.PlatformStand = true
    bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(300000, 300000, 300000)
    bv.Velocity = Vector3.zero
    bv.Parent = r

    bg = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.new(300000, 300000, 300000)
    bg.P = 9000
    bg.CFrame = r.CFrame
    bg.Parent = r

    flyConn = RunService.RenderStepped:Connect(function()
        if not fly or not char.Parent or not h or not r then
            stopFly()
            return
        end
        bg.CFrame = Cam.CFrame
        local velocity = Vector3.zero
        if ControlModule then
            local rawMove = ControlModule:GetMoveVector()
            if rawMove.Magnitude > 0 then
                velocity = (Cam.CFrame.LookVector * -rawMove.Z + Cam.CFrame.RightVector * rawMove.X) * spd
            end
        end
        bv.Velocity = velocity
    end)
end

