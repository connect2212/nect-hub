-- ==================== PRO ESP & CHAMS (MASTER TOGGLE) ====================
local masterEspEnabled = false
local boxEnabled = false
local nameEnabled = false
local healthEnabled = false
local chamsEnabled = false

local espColor = Color3.fromRGB(255, 50, 50)
local chamsColor = Color3.fromRGB(0, 255, 255)

local espCache = {}
local chamsCache = {}

local function createESP(p)
    if p == LP then return end
    
    local box = Drawing.new("Square")
    box.Visible = false
    box.Thickness = 1.5
    box.Filled = false

    local nameText = Drawing.new("Text")
    nameText.Visible = false
    nameText.Size = 13
    nameText.Center = true
    nameText.Outline = true

    local healthBg = Drawing.new("Square")
    healthBg.Visible = false
    healthBg.Color = Color3.fromRGB(0, 0, 0)
    healthBg.Thickness = 1
    healthBg.Filled = true

    local healthBar = Drawing.new("Square")
    healthBar.Visible = false
    healthBar.Thickness = 1
    healthBar.Filled = true

    espCache[p] = {Box = box, Name = nameText, HealthBg = healthBg, Health = healthBar}

    local function setupChams(char)
        if chamsCache[p] then
            pcall(function() chamsCache[p]:Destroy() end)
            chamsCache[p] = nil
        end
        local highlight = Instance.new("Highlight")
        highlight.Name = "ProChams"
        highlight.Adornee = char
        highlight.FillColor = chamsColor
        highlight.OutlineColor = chamsColor
        highlight.FillTransparency = 0.5
        highlight.OutlineTransparency = 0
        highlight.Enabled = false
        highlight.Parent = char
        chamsCache[p] = highlight
    end

    p.CharacterAdded:Connect(setupChams)
    if p.Character then
        setupChams(p.Character)
    end
end

local function removeESP(p)
    if espCache[p] then
        for _, obj in pairs(espCache[p]) do
            pcall(function() obj:Remove() end)
        end
        espCache[p] = nil
    end
    if chamsCache[p] then
        pcall(function() chamsCache[p]:Destroy() end)
        chamsCache[p] = nil
    end
end

for _, p in ipairs(Players:GetPlayers()) do createESP(p) end
Players.PlayerAdded:Connect(createESP)
Players.PlayerRemoving:Connect(removeESP)

RunService.RenderStepped:Connect(function()
    for p, highlight in pairs(chamsCache) do
        if highlight and highlight.Parent then
            highlight.Enabled = masterEspEnabled and chamsEnabled
            highlight.FillColor = chamsColor
            highlight.OutlineColor = chamsColor
        end
    end

    for p, cache in pairs(espCache) do
        local char = p.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local humanoid = char and char:FindFirstChildOfClass("Humanoid")
        local head = char and char:FindFirstChild("Head")

        if masterEspEnabled and char and hrp and humanoid and head and humanoid.Health > 0 then
            local vector, onScreen = Cam:WorldToViewportPoint(hrp.Position)
            if onScreen then
                local topPos = head.Position + Vector3.new(0, 0.5, 0)
                local bottomPos = hrp.Position - Vector3.new(0, 3, 0)
                
                local topScreen = Cam:WorldToViewportPoint(topPos)
                local bottomScreen = Cam:WorldToViewportPoint(bottomPos)
                
                local height = math.abs(topScreen.Y - bottomScreen.Y)
                local width = height / 2
                
                if boxEnabled then
                    cache.Box.Size = Vector2.new(width, height)
                    cache.Box.Position = Vector2.new(topScreen.X - width / 2, topScreen.Y)
                    cache.Box.Color = espColor
                    cache.Box.Visible = true
                else
                    cache.Box.Visible = false
                end

                if nameEnabled then
                    local dist = math.floor((Cam.CFrame.Position - hrp.Position).Magnitude)
                    cache.Name.Text = p.Name .. " [" .. dist .. "m]"
                    cache.Name.Position = Vector2.new(topScreen.X, topScreen.Y - 18)
                    cache.Name.Color = espColor
                    cache.Name.Visible = true
                else
                    cache.Name.Visible = false
                end

                if healthEnabled then
                    local hpPct = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
                    local barHeight = height * hpPct
                    
                    cache.HealthBg.Size = Vector2.new(3, height + 2)
                    cache.HealthBg.Position = Vector2.new(cache.Box.Position.X - 6, cache.Box.Position.Y - 1)
                    cache.HealthBg.Visible = true

                    cache.Health.Size = Vector2.new(1, barHeight)
                    cache.Health.Position = Vector2.new(cache.Box.Position.X - 5, cache.Box.Position.Y + (height - barHeight))
                    cache.Health.Color = Color3.fromRGB(255 - (hpPct * 255), hpPct * 255, 0)
                    cache.Health.Visible = true
                else
                    cache.HealthBg.Visible = false
                    cache.Health.Visible = false
                end
            else
                cache.Box.Visible = false
                cache.Name.Visible = false
                cache.HealthBg.Visible = false
                cache.Health.Visible = false
            end
        else
            cache.Box.Visible = false
            cache.Name.Visible = false
            cache.HealthBg.Visible = false
            cache.Health.Visible = false
        end
    end
end)

